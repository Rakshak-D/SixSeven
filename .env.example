# Copy to .env (never commit .env). Replace sanitized placeholders before local use.
DATABASE_URL=postgres://slate:replace-with-a-local-password@127.0.0.1:5432/slate_demo
SLATE_MIGRATION_DATABASE=slate_demo
# Set a URL-safe local password. Use the same value in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=slate_demo
# Host port for the compose Postgres; change if 5432 is taken (and update DATABASE_URL).
DB_PORT=5432

# Better Auth: generate a secret with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# Uncomment locally for a disposable demo database. Replace the password placeholder.
# SLATE_DEMO_SEED=1
# SLATE_DEMO_PASSWORD=replace-with-a-local-demo-password

# Uploaded progress photos (private project-local storage).
UPLOAD_DIR=./.cache/uploads

# Frontend: 1 = answer from src/mocks for routes not live yet.
NEXT_PUBLIC_USE_MOCKS=0

# Optional Ask Slate and checklist provider. Without a key Ask Slate is offline and checklists use templates.
# AI_PROVIDER=groq|gemini|nvidia|openai-compatible
# AI_MODEL= # e.g. openai/gpt-oss-120b on groq
# AI_API_KEY=
# AI_BASE_URL= # Required for an explicitly selected OpenAI-compatible endpoint
