# Copy to .env (never commit .env). Values here are local-dev defaults only.
DATABASE_URL=postgres://sixseven:sixseven@localhost:5432/sixseven
# Host port for the compose Postgres; change if 5432 is taken (and update DATABASE_URL).
DB_PORT=5432

# Better Auth: generate a secret with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# Uploaded progress photos (local disk driver).
UPLOAD_DIR=./uploads

# Frontend: 1 = answer from src/mocks for routes not live yet.
NEXT_PUBLIC_USE_MOCKS=1

# AI checklist (stretch). Leave AI_API_KEY unset to use the template fallback.
# AI_PROVIDER=groq|gemini|nvidia
# AI_MODEL=
# AI_API_KEY=
